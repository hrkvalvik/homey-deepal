{
  "triggers": [
    {
      "id": "charging_started",
      "title": {
        "en": "Charging started",
        "no": "Lading startet"
      }
    },
    {
      "id": "charging_stopped",
      "title": {
        "en": "Charging stopped",
        "no": "Lading stoppet"
      }
    },
    {
      "id": "warning_light_on",
      "title": {
        "en": "A dashboard warning light turned on",
        "no": "Et varsellys i dashbordet ble slått på"
      },
      "hint": {
        "en": "S05 only: reported while the car is on.",
        "no": "Kun S05: rapporteres mens bilen er på."
      },
      "tokens": [
        {
          "name": "light",
          "type": "string",
          "title": {
            "en": "Warning light",
            "no": "Varsellys"
          },
          "example": {
            "en": "ABS warning",
            "no": "ABS-varsel"
          }
        }
      ]
    }
  ],
  "conditions": [
    {
      "id": "is_charging",
      "title": {
        "en": "Is !{{|not}} charging",
        "no": "Lader !{{|ikke}}"
      }
    },
    {
      "id": "is_plugged_in",
      "title": {
        "en": "Is !{{|not}} plugged in",
        "no": "Er !{{|ikke}} koblet til lader"
      }
    }
  ],
  "actions": [
    {
      "id": "climate_on",
      "title": {
        "en": "Start climate",
        "no": "Start klima"
      },
      "titleFormatted": {
        "en": "Start climate at [[temperature]] °C",
        "no": "Start klima på [[temperature]] °C"
      },
      "args": [
        {
          "type": "number",
          "name": "temperature",
          "min": 16,
          "max": 32,
          "step": 0.5,
          "placeholder": {
            "en": "22",
            "no": "22"
          }
        }
      ]
    },
    {
      "id": "climate_off",
      "title": {
        "en": "Stop climate",
        "no": "Stopp klima"
      }
    },
    {
      "id": "flash_lights",
      "title": {
        "en": "Flash the lights",
        "no": "Blink med lysene"
      }
    },
    {
      "id": "sound_horn",
      "title": {
        "en": "Sound the horn",
        "no": "Tut med hornet"
      }
    },
    {
      "id": "flash_and_horn",
      "title": {
        "en": "Flash the lights and sound the horn",
        "no": "Blink med lysene og tut med hornet"
      }
    },
    {
      "id": "open_trunk",
      "title": {
        "en": "Open the trunk",
        "no": "Åpne bagasjerommet"
      },
      "hint": {
        "en": "Requires the remote-control PIN.",
        "no": "Krever PIN-koden for fjernkontroll."
      }
    },
    {
      "id": "set_windows",
      "title": {
        "en": "Open or close the windows",
        "no": "Åpne eller lukke vinduene"
      },
      "titleFormatted": {
        "en": "[[state]] the windows",
        "no": "[[state]] vinduene"
      },
      "hint": {
        "en": "Requires the remote-control PIN.",
        "no": "Krever PIN-koden for fjernkontroll."
      },
      "args": [
        {
          "type": "dropdown",
          "name": "state",
          "values": [
            {
              "id": "open",
              "label": {
                "en": "Open",
                "no": "Åpne"
              }
            },
            {
              "id": "close",
              "label": {
                "en": "Close",
                "no": "Lukk"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "set_charge_limit",
      "title": {
        "en": "Set charge limit",
        "no": "Sett ladegrense"
      },
      "titleFormatted": {
        "en": "Set charge limit to [[percent]] %",
        "no": "Sett ladegrense til [[percent]] %"
      },
      "hint": {
        "en": "Not supported by the S05 EV (the car accepts it without effect).",
        "no": "Støttes ikke av S05 EV (bilen godtar den uten effekt)."
      },
      "args": [
        {
          "type": "range",
          "name": "percent",
          "min": 50,
          "max": 100,
          "step": 5,
          "label": " %"
        }
      ]
    },
    {
      "id": "wake_and_refresh",
      "title": {
        "en": "Wake the car and refresh",
        "no": "Vekk bilen og oppdater"
      },
      "hint": {
        "en": "Wakes an S05 (at most once every 5 minutes) and waits up to 60 s for a fresh report.",
        "no": "Vekker en S05 (maks én gang hvert 5. minutt) og venter opptil 60 s på en ny rapport."
      }
    },
    {
      "id": "set_seat_heat",
      "title": {
        "en": "Set seat heating",
        "no": "Sett setevarme"
      },
      "titleFormatted": {
        "en": "Set [[seat]] seat heating to [[level]]",
        "no": "Sett setevarme for [[seat]] til [[level]]"
      },
      "args": [
        {
          "type": "dropdown",
          "name": "seat",
          "values": [
            {
              "id": "driver",
              "label": {
                "en": "driver",
                "no": "fører"
              }
            },
            {
              "id": "passenger",
              "label": {
                "en": "passenger",
                "no": "passasjer"
              }
            },
            {
              "id": "both",
              "label": {
                "en": "both front",
                "no": "begge foran"
              }
            }
          ]
        },
        {
          "type": "dropdown",
          "name": "level",
          "values": [
            {
              "id": "0",
              "label": {
                "en": "Off",
                "no": "Av"
              }
            },
            {
              "id": "1",
              "label": {
                "en": "Level 1",
                "no": "Nivå 1"
              }
            },
            {
              "id": "2",
              "label": {
                "en": "Level 2",
                "no": "Nivå 2"
              }
            },
            {
              "id": "3",
              "label": {
                "en": "Level 3",
                "no": "Nivå 3"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "set_steering_wheel_heat",
      "title": {
        "en": "Turn steering wheel heating on or off",
        "no": "Slå rattvarme av eller på"
      },
      "titleFormatted": {
        "en": "Turn steering wheel heating [[state]]",
        "no": "Slå rattvarme [[state]]"
      },
      "args": [
        {
          "type": "dropdown",
          "name": "state",
          "values": [
            {
              "id": "on",
              "label": {
                "en": "on",
                "no": "på"
              }
            },
            {
              "id": "off",
              "label": {
                "en": "off",
                "no": "av"
              }
            }
          ]
        }
      ]
    }
  ]
}
