      "insightsTitleTrue": {
        "en": "Steering wheel heating on",
        "no": "Rattvarme på"
      },
      "insightsTitleFalse": {
        "en": "Steering wheel heating off",
        "no": "Rattvarme av"
      },
      "uiComponent": "toggle",
      "icon": "/assets/capabilities/steering-wheel.svg"
    },
    "deepal_tire_pressure": {
