{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.github.deepal.alternative",
  "version": "0.2.0",
  "compatibility": ">=12.4.5",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Deepal"
  },
  "description": {
    "en": "Battery, charging, climate and remote control for Deepal / Changan cars",
    "no": "Batteri, lading, klima og fjernkontroll for Deepal / Changan-biler"
  },
  "category": [
    "climate"
  ],
  "permissions": [],
  "brandColor": "#1B3A5B",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "hrkvalvik"
  },
  "support": "https://github.com/hrkvalvik/homey-deepal/issues",
  "source": "https://github.com/hrkvalvik/homey-deepal",
  "flow": {
    "triggers": [
      {
        "id": "charging_started",
        "title": {
          "en": "Charging started",
          "no": "Lading startet"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      },
      {
        "id": "charging_stopped",
        "title": {
          "en": "Charging stopped",
          "no": "Lading stoppet"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      },
      {
        "id": "warning_light_on",
        "title": {
          "en": "A dashboard warning light turned on",
          "no": "Et varsellys i dashbordet ble slått på"
        },
        "hint": {
          "en": "S05 only: reported while the car is on.",
          "no": "Kun S05: rapporteres mens bilen er på."
        },
        "tokens": [
          {
            "name": "light",
            "type": "string",
            "title": {
              "en": "Warning light",
              "no": "Varsellys"
            },
            "example": {
              "en": "ABS warning",
              "no": "ABS-varsel"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "is_charging",
        "title": {
          "en": "Is !{{|not}} charging",
          "no": "Lader !{{|ikke}}"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      },
      {
        "id": "is_plugged_in",
        "title": {
          "en": "Is !{{|not}} plugged in",
          "no": "Er !{{|ikke}} koblet til lader"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "climate_on",
        "title": {
          "en": "Start climate",
          "no": "Start klima"
        },
        "titleFormatted": {
          "en": "Start climate at [[temperature]] °C",
          "no": "Start klima på [[temperature]] °C"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          },
          {
            "type": "number",
            "name": "temperature",
            "min": 16,
            "max": 32,
            "step": 0.5,
            "placeholder": {
              "en": "22",
              "no": "22"
            }
          }
        ]
      },
      {
        "id": "climate_off",
        "title": {
          "en": "Stop climate",
          "no": "Stopp klima"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      },
      {
        "id": "flash_lights",
        "title": {
          "en": "Flash the lights",
          "no": "Blink med lysene"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      },
      {
        "id": "sound_horn",
        "title": {
          "en": "Sound the horn",
          "no": "Tut med hornet"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      },
      {
        "id": "flash_and_horn",
        "title": {
          "en": "Flash the lights and sound the horn",
          "no": "Blink med lysene og tut med hornet"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      },
      {
        "id": "open_trunk",
        "title": {
          "en": "Open the trunk",
          "no": "Åpne bagasjerommet"
        },
        "hint": {
          "en": "Requires the remote-control PIN.",
          "no": "Krever PIN-koden for fjernkontroll."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      },
      {
        "id": "set_windows",
        "title": {
          "en": "Open or close the windows",
          "no": "Åpne eller lukke vinduene"
        },
        "titleFormatted": {
          "en": "[[state]] the windows",
          "no": "[[state]] vinduene"
        },
        "hint": {
          "en": "Requires the remote-control PIN.",
          "no": "Krever PIN-koden for fjernkontroll."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          },
          {
            "type": "dropdown",
            "name": "state",
            "values": [
              {
                "id": "open",
                "label": {
                  "en": "Open",
                  "no": "Åpne"
                }
              },
              {
                "id": "close",
                "label": {
                  "en": "Close",
                  "no": "Lukk"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "set_charge_limit",
        "title": {
          "en": "Set charge limit",
          "no": "Sett ladegrense"
        },
        "titleFormatted": {
          "en": "Set charge limit to [[percent]] %",
          "no": "Sett ladegrense til [[percent]] %"
        },
        "hint": {
          "en": "Not supported by the S05 EV (the car accepts it without effect).",
          "no": "Støttes ikke av S05 EV (bilen godtar den uten effekt)."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          },
          {
            "type": "range",
            "name": "percent",
            "min": 50,
            "max": 100,
            "step": 5,
            "label": " %"
          }
        ]
      },
      {
        "id": "wake_and_refresh",
        "title": {
          "en": "Wake the car and refresh",
          "no": "Vekk bilen og oppdater"
        },
        "hint": {
          "en": "Wakes an S05 (at most once every 5 minutes) and waits up to 60 s for a fresh report.",
          "no": "Vekker en S05 (maks én gang hvert 5. minutt) og venter opptil 60 s på en ny rapport."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      },
      {
        "id": "set_seat_heat",
        "title": {
          "en": "Set seat heating",
          "no": "Sett setevarme"
        },
        "titleFormatted": {
          "en": "Set [[seat]] seat heating to [[level]]",
          "no": "Sett setevarme for [[seat]] til [[level]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          },
          {
            "type": "dropdown",
            "name": "seat",
            "values": [
              {
                "id": "driver",
                "label": {
                  "en": "driver",
                  "no": "fører"
                }
              },
              {
                "id": "passenger",
                "label": {
                  "en": "passenger",
                  "no": "passasjer"
                }
              },
              {
                "id": "both",
                "label": {
                  "en": "both front",
                  "no": "begge foran"
                }
              }
            ]
          },
          {
            "type": "dropdown",
            "name": "level",
            "values": [
              {
                "id": "0",
                "label": {
                  "en": "Off",
                  "no": "Av"
                }
              },
              {
                "id": "1",
                "label": {
                  "en": "Level 1",
                  "no": "Nivå 1"
                }
              },
              {
                "id": "2",
                "label": {
                  "en": "Level 2",
                  "no": "Nivå 2"
                }
              },
              {
                "id": "3",
                "label": {
                  "en": "Level 3",
                  "no": "Nivå 3"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "set_steering_wheel_heat",
        "title": {
          "en": "Turn steering wheel heating on or off",
          "no": "Slå rattvarme av eller på"
        },
        "titleFormatted": {
          "en": "Turn steering wheel heating [[state]]",
          "no": "Slå rattvarme [[state]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          },
          {
            "type": "dropdown",
            "name": "state",
            "values": [
              {
                "id": "on",
                "label": {
                  "en": "on",
                  "no": "på"
                }
              },
              {
                "id": "off",
                "label": {
                  "en": "off",
                  "no": "av"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Deepal vehicle",
        "no": "Deepal-kjøretøy"
      },
      "class": "car",
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "capabilities": [
        "measure_battery",
        "ev_charging_state",
        "deepal_range",
        "deepal_charge_time_remaining",
        "measure_current",
        "locked",
        "deepal_climate",
        "target_temperature",
        "deepal_seat_heat.driver",
        "deepal_seat_heat.passenger",
        "deepal_steering_wheel_heat",
        "measure_temperature",
        "measure_temperature.outside",
        "measure_humidity",
        "alarm_contact.doors",
        "alarm_contact.trunk",
        "alarm_contact.windows",
        "deepal_tire_pressure.front_left",
        "deepal_tire_pressure.front_right",
        "deepal_tire_pressure.rear_left",
        "deepal_tire_pressure.rear_right",
        "alarm_generic.tire_pressure",
        "deepal_odometer",
        "deepal_last_update"
      ],
      "capabilitiesOptions": {
        "target_temperature": {
          "min": 16,
          "max": 32,
          "step": 0.5
        },
        "measure_temperature": {
          "title": {
            "en": "Cabin temperature",
            "no": "Kupétemperatur"
          }
        },
        "measure_temperature.outside": {
          "title": {
            "en": "Outside temperature",
            "no": "Utetemperatur"
          }
        },
        "measure_humidity": {
          "title": {
            "en": "Cabin humidity",
            "no": "Luftfuktighet i kupeen"
          }
        },
        "measure_current": {
          "title": {
            "en": "Charge current",
            "no": "Ladestrøm"
          }
        },
        "locked": {
          "title": {
            "en": "Locked",
            "no": "Låst"
          }
        },
        "alarm_contact.doors": {
          "title": {
            "en": "Doors / hood open",
            "no": "Dører / panser åpent"
          }
        },
        "alarm_contact.trunk": {
          "title": {
            "en": "Trunk open",
            "no": "Bagasjerom åpent"
          }
        },
        "alarm_contact.windows": {
          "title": {
            "en": "Windows open",
            "no": "Vinduer åpne"
          }
        },
        "deepal_tire_pressure.front_left": {
          "title": {
            "en": "Tire pressure front left",
            "no": "Dekktrykk foran venstre"
          }
        },
        "deepal_tire_pressure.front_right": {
          "title": {
            "en": "Tire pressure front right",
            "no": "Dekktrykk foran høyre"
          }
        },
        "deepal_tire_pressure.rear_left": {
          "title": {
            "en": "Tire pressure rear left",
            "no": "Dekktrykk bak venstre"
          }
        },
        "deepal_tire_pressure.rear_right": {
          "title": {
            "en": "Tire pressure rear right",
            "no": "Dekktrykk bak høyre"
          }
        },
        "alarm_generic.tire_pressure": {
          "title": {
            "en": "Tire pressure warning",
            "no": "Dekktrykkvarsel"
          }
        },
        "deepal_seat_heat.driver": {
          "title": {
            "en": "Driver seat heating",
            "no": "Setevarme fører"
          }
        },
        "deepal_seat_heat.passenger": {
          "title": {
            "en": "Passenger seat heating",
            "no": "Setevarme passasjer"
          }
        }
      },
      "energy": {
        "electricCar": true
      },
      "images": {
        "small": "/drivers/vehicle/assets/images/small.png",
        "large": "/drivers/vehicle/assets/images/large.png",
        "xlarge": "/drivers/vehicle/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "login"
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "login"
        }
      ],
      "id": "vehicle",
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Polling",
            "no": "Datahenting"
          },
          "children": [
            {
              "id": "poll_interval",
              "type": "number",
              "label": {
                "en": "Poll interval",
                "no": "Oppdateringsintervall"
              },
              "hint": {
                "en": "Minutes between status reads. A normal poll never wakes the car.",
                "no": "Minutter mellom hver statuslesing. En vanlig lesing vekker aldri bilen."
              },
              "value": 5,
              "min": 2,
              "max": 120,
              "units": {
                "en": "min",
                "no": "min"
              }
            },
            {
              "id": "allow_wake",
              "type": "checkbox",
              "label": {
                "en": "Wake the car before lock, window and trunk commands",
                "no": "Vekk bilen før lås-, vindus- og bagasjeromskommandoer"
              },
              "hint": {
                "en": "Only for MQTT cars (S05). Wakes are limited to one every 5 minutes to protect the 12 V battery.",
                "no": "Kun for MQTT-biler (S05). Oppvåkning er begrenset til én hvert 5. minutt for å skåne 12 V-batteriet."
              },
              "value": true
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Remote control",
            "no": "Fjernkontroll"
          },
          "children": [
            {
              "id": "control_pin",
              "type": "password",
              "label": {
                "en": "Remote-control PIN",
                "no": "PIN-kode for fjernkontroll"
              },
              "hint": {
                "en": "The 6-digit PIN created in the My Changan app with the account Homey signs in with. Required to lock/unlock and open windows or trunk. It is verified when saved.",
                "no": "Den 6-sifrede PIN-koden som er opprettet i My Changan-appen med kontoen Homey logger inn med. Kreves for å låse/låse opp og åpne vinduer eller bagasjerom. Den kontrolleres når den lagres."
              },
              "value": ""
            },
            {
              "id": "climate_runtime",
              "type": "number",
              "label": {
                "en": "Climate run time",
                "no": "Kjøretid for klima"
              },
              "value": 30,
              "min": 5,
              "max": 30,
              "units": {
                "en": "min",
                "no": "min"
              }
            }
          ]
        }
      ]
    }
  ],
  "widgets": {
    "car": {
      "name": {
        "en": "Deepal car",
        "no": "Deepal-bil"
      },
      "height": 430,
      "transparent": false,
      "api": {
        "getState": {
          "method": "GET",
          "path": "/state"
        },
        "command": {
          "method": "POST",
          "path": "/command"
        }
      },
      "id": "car",
      "settings": []
    }
  },
  "capabilities": {
    "deepal_charge_time_remaining": {
      "type": "number",
      "title": {
        "en": "Charge time remaining",
        "no": "Gjenstående ladetid"
      },
      "units": {
        "en": "min",
        "no": "min"
      },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "insights": false,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/timer.svg"
    },
    "deepal_climate": {
      "type": "boolean",
      "title": {
        "en": "Climate",
        "no": "Klima"
      },
      "getable": true,
      "setable": true,
      "insights": true,
      "insightsTitleTrue": {
        "en": "Climate turned on",
        "no": "Klima slått på"
      },
      "insightsTitleFalse": {
        "en": "Climate turned off",
        "no": "Klima slått av"
      },
      "uiComponent": "toggle",
      "uiQuickAction": true,
      "icon": "/assets/capabilities/climate.svg"
    },
    "deepal_last_update": {
      "type": "string",
      "title": {
        "en": "Last report",
        "no": "Siste rapport"
