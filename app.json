        "locked",
        "deepal_climate",
        "target_temperature",
        "deepal_seat_heat.driver",
        "deepal_seat_heat.passenger",
        "deepal_steering_wheel_heat",
        "measure_temperature",
        "measure_temperature.outside",
        "measure_humidity",
        "alarm_contact.doors",
        "alarm_contact.trunk",
        "alarm_contact.windows",
        "deepal_tire_pressure.front_left",
        "deepal_tire_pressure.front_right",
        "deepal_tire_pressure.rear_left",
        "deepal_tire_pressure.rear_right",
        "alarm_generic.tire_pressure",
        "deepal_odometer",
        "deepal_last_update"
      ],
      "capabilitiesOptions": {
        "target_temperature": {
          "min": 16,
          "max": 32,
          "step": 0.5
        },
        "measure_temperature": {
          "title": {
            "en": "Cabin temperature"
          }
        },
        "measure_temperature.outside": {
          "title": {
            "en": "Outside temperature"
          }
        },
        "measure_humidity": {
          "title": {
            "en": "Cabin humidity"
          }
        },
        "measure_current": {
          "title": {
            "en": "Charge current"
          }
        },
        "locked": {
          "title": {
            "en": "Locked"
          }
        },
        "alarm_contact.doors": {
          "title": {
            "en": "Doors / hood open"
          }
        },
        "alarm_contact.trunk": {
          "title": {
            "en": "Trunk open"
          }
        },
        "alarm_contact.windows": {
          "title": {
            "en": "Windows open"
          }
        },
        "deepal_tire_pressure.front_left": {
          "title": {
            "en": "Tire pressure front left"
          }
        },
        "deepal_tire_pressure.front_right": {
          "title": {
            "en": "Tire pressure front right"
          }
        },
        "deepal_tire_pressure.rear_left": {
          "title": {
            "en": "Tire pressure rear left"
          }
        },
        "deepal_tire_pressure.rear_right": {
          "title": {
            "en": "Tire pressure rear right"
          }
        },
        "alarm_generic.tire_pressure": {
          "title": {
            "en": "Tire pressure warning"
          }
        },
        "deepal_seat_heat.driver": {
          "title": {
            "en": "Driver seat heating",
            "no": "Setevarme fører"
          }
        },
        "deepal_seat_heat.passenger": {
          "title": {
            "en": "Passenger seat heating",
            "no": "Setevarme passasjer"
          }
        }
      },
      "energy": {
        "electricCar": true
      },
      "images": {
        "small": "/drivers/vehicle/assets/images/small.png",
        "large": "/drivers/vehicle/assets/images/large.png",
        "xlarge": "/drivers/vehicle/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "login"
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "login"
        }
      ],
      "id": "vehicle",
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Polling"
          },
          "children": [
            {
              "id": "poll_interval",
              "type": "number",
              "label": {
                "en": "Poll interval"
              },
              "hint": {
                "en": "Minutes between status reads. A normal poll never wakes the car."
              },
              "value": 5,
              "min": 2,
              "max": 120,
              "units": {
                "en": "min"
              }
            },
            {
              "id": "allow_wake",
              "type": "checkbox",
              "label": {
                "en": "Wake the car before lock, window and trunk commands"
              },
              "hint": {
                "en": "Only for MQTT cars (S05). Wakes are limited to one every 5 minutes to protect the 12 V battery."
              },
              "value": true
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Remote control"
          },
          "children": [
            {
              "id": "control_pin",
              "type": "password",
              "label": {
                "en": "Remote-control PIN"
              },
              "hint": {
                "en": "The 6-digit PIN created in the My Changan app with the account Homey signs in with. Required to lock/unlock and open windows or trunk. It is verified when saved."
              },
              "value": ""
            },
            {
              "id": "climate_runtime",
              "type": "number",
              "label": {
                "en": "Climate run time"
              },
              "value": 30,
              "min": 5,
              "max": 30,
              "units": {
                "en": "min"
              }
            }
          ]
        }
      ]
    }
  ],
  "widgets": {
    "car": {
      "name": {
        "en": "Deepal car"
      },
      "height": 430,
      "transparent": false,
      "api": {
        "getState": {
          "method": "GET",
          "path": "/state"
        },
        "command": {
          "method": "POST",
          "path": "/command"
        }
      },
      "id": "car",
      "settings": []
    }
  },
  "capabilities": {
    "deepal_charge_time_remaining": {
      "type": "number",
      "title": {
        "en": "Charge time remaining"
      },
      "units": {
        "en": "min"
      },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "insights": false,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/timer.svg"
    },
    "deepal_climate": {
      "type": "boolean",
      "title": {
        "en": "Climate"
      },
      "getable": true,
      "setable": true,
      "insights": true,
      "insightsTitleTrue": {
        "en": "Climate turned on"
      },
      "insightsTitleFalse": {
        "en": "Climate turned off"
      },
      "uiComponent": "toggle",
      "uiQuickAction": true,
      "icon": "/assets/capabilities/climate.svg"
    },
    "deepal_last_update": {
      "type": "string",
      "title": {
        "en": "Last report"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/clock.svg"
    },
    "deepal_odometer": {
      "type": "number",
      "title": {
        "en": "Odometer"
      },
      "units": {
        "en": "km"
      },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/odometer.svg"
    },
    "deepal_range": {
      "type": "number",
      "title": {
        "en": "Range"
      },
      "units": {
        "en": "km"
      },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/range.svg"
    },
    "deepal_seat_heat": {
      "type": "enum",
      "title": {
        "en": "Seat heating",
        "no": "Setevarme"
      },
      "values": [
        {
          "id": "0",
          "title": {
            "en": "Off",
            "no": "Av"
          }
        },
        {
          "id": "1",
          "title": {
            "en": "Level 1",
            "no": "Nivå 1"
          }
        },
        {
          "id": "2",
          "title": {
            "en": "Level 2",
            "no": "Nivå 2"
          }
        },
        {
          "id": "3",
          "title": {
            "en": "Level 3",
            "no": "Nivå 3"
          }
        }
      ],
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "icon": "/assets/capabilities/seat-heat.svg"
