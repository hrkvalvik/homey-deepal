{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.github.deepal.alternative",
  "version": "0.2.0",
  "compatibility": ">=12.4.5",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Deepal"
  },
  "description": {
    "en": "Battery, charging, climate and remote control for Deepal / Changan cars"
  },
  "category": [
    "climate"
  ],
  "permissions": [],
  "brandColor": "#1B3A5B",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Your Name",
    "email": "you@example.com"
  },
  "support": "https://github.com/YOUR_USER/homey-deepal/issues",
  "source": "https://github.com/YOUR_USER/homey-deepal",
  "flow": {
    "triggers": [
      {
        "id": "charging_started",
        "title": {
          "en": "Charging started"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      },
      {
        "id": "charging_stopped",
        "title": {
          "en": "Charging stopped"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      },
      {
        "id": "warning_light_on",
        "title": {
          "en": "A dashboard warning light turned on"
        },
        "hint": {
          "en": "S05 only: reported while the car is on."
        },
        "tokens": [
          {
            "name": "light",
            "type": "string",
            "title": {
              "en": "Warning light"
            },
            "example": {
              "en": "ABS warning"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "is_charging",
        "title": {
          "en": "Is !{{|not}} charging"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      },
      {
        "id": "is_plugged_in",
        "title": {
          "en": "Is !{{|not}} plugged in"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "climate_on",
        "title": {
          "en": "Start climate"
        },
        "titleFormatted": {
          "en": "Start climate at [[temperature]] °C"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          },
          {
            "type": "number",
            "name": "temperature",
            "min": 16,
            "max": 32,
            "step": 0.5,
            "placeholder": {
              "en": "22"
            }
          }
        ]
      },
      {
        "id": "climate_off",
        "title": {
          "en": "Stop climate"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      },
      {
        "id": "flash_lights",
        "title": {
          "en": "Flash the lights"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      },
      {
        "id": "sound_horn",
        "title": {
          "en": "Sound the horn"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      },
      {
        "id": "flash_and_horn",
        "title": {
          "en": "Flash the lights and sound the horn"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      },
      {
        "id": "open_trunk",
        "title": {
          "en": "Open the trunk"
        },
        "hint": {
          "en": "Requires the remote-control PIN."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      },
      {
        "id": "set_windows",
        "title": {
          "en": "Open or close the windows"
        },
        "titleFormatted": {
          "en": "[[state]] the windows"
        },
        "hint": {
          "en": "Requires the remote-control PIN."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          },
          {
            "type": "dropdown",
            "name": "state",
            "values": [
              {
                "id": "open",
                "label": {
                  "en": "Open"
                }
              },
              {
                "id": "close",
                "label": {
                  "en": "Close"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "set_charge_limit",
        "title": {
          "en": "Set charge limit"
        },
        "titleFormatted": {
          "en": "Set charge limit to [[percent]] %"
        },
        "hint": {
          "en": "Not supported by the S05 EV (the car accepts it without effect)."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          },
          {
            "type": "range",
            "name": "percent",
            "min": 50,
            "max": 100,
            "step": 5,
            "label": " %"
          }
        ]
      },
      {
        "id": "wake_and_refresh",
        "title": {
          "en": "Wake the car and refresh"
        },
        "hint": {
          "en": "Wakes an S05 (at most once every 5 minutes) and waits up to 60 s for a fresh report."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          }
        ]
      },
      {
        "id": "set_seat_heat",
        "title": {
          "en": "Set seat heating",
          "no": "Sett setevarme"
        },
        "titleFormatted": {
          "en": "Set [[seat]] seat heating to [[level]]",
          "no": "Sett setevarme for [[seat]] til [[level]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          },
          {
            "type": "dropdown",
            "name": "seat",
            "values": [
              {
                "id": "driver",
                "label": {
                  "en": "driver",
                  "no": "fører"
                }
              },
              {
                "id": "passenger",
                "label": {
                  "en": "passenger",
                  "no": "passasjer"
                }
              },
              {
                "id": "both",
                "label": {
                  "en": "both front",
                  "no": "begge foran"
                }
              }
            ]
          },
          {
            "type": "dropdown",
            "name": "level",
            "values": [
              {
                "id": "0",
                "label": {
                  "en": "Off",
                  "no": "Av"
                }
              },
              {
                "id": "1",
                "label": {
                  "en": "Level 1",
                  "no": "Nivå 1"
                }
              },
              {
                "id": "2",
                "label": {
                  "en": "Level 2",
                  "no": "Nivå 2"
                }
              },
              {
                "id": "3",
                "label": {
                  "en": "Level 3",
                  "no": "Nivå 3"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "set_steering_wheel_heat",
        "title": {
          "en": "Turn steering wheel heating on or off",
          "no": "Slå rattvarme av eller på"
        },
        "titleFormatted": {
          "en": "Turn steering wheel heating [[state]]",
          "no": "Slå rattvarme [[state]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=vehicle"
          },
          {
            "type": "dropdown",
            "name": "state",
            "values": [
              {
                "id": "on",
                "label": {
                  "en": "on",
                  "no": "på"
                }
              },
              {
                "id": "off",
                "label": {
                  "en": "off",
                  "no": "av"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Deepal vehicle"
      },
      "class": "car",
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud"
      ],
      "capabilities": [
        "measure_battery",
        "ev_charging_state",
