      "title": {
        "en": "Odometer",
        "no": "Kilometerteller"
      },
      "units": {
        "en": "km",
        "no": "km"
      },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/odometer.svg"
    },
    "deepal_range": {
      "type": "number",
      "title": {
        "en": "Range",
        "no": "Rekkevidde"
      },
      "units": {
        "en": "km",
        "no": "km"
      },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "insights": true,
      "uiComponent": "sensor",
      "icon": "/assets/capabilities/range.svg"
    },
    "deepal_seat_heat": {
      "type": "enum",
      "title": {
        "en": "Seat heating",
        "no": "Setevarme"
      },
      "values": [
        {
          "id": "0",
          "title": {
            "en": "Off",
            "no": "Av"
          }
        },
        {
          "id": "1",
          "title": {
            "en": "Level 1",
            "no": "Nivå 1"
          }
        },
        {
          "id": "2",
          "title": {
            "en": "Level 2",
            "no": "Nivå 2"
          }
        },
        {
          "id": "3",
          "title": {
            "en": "Level 3",
            "no": "Nivå 3"
          }
        }
      ],
      "getable": true,
      "setable": true,
